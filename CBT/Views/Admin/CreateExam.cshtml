@model CreateExamViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Exam";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="Admin" asp-action="Exams" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="page-title mb-0"><i class="bi bi-plus-circle me-2"></i>Create New Exam</h2>
            <p class="text-muted mb-0">Fill in the exam details below</p>
        </div>
    </div>

    <div class="card ncs-card">
        <div class="card-body p-4">
            <form asp-controller="Admin" asp-action="CreateExam" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-medium"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. NCS 2026 General Assessment" autofocus />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-medium"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Brief description of this exam..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DurationMinutes" class="form-label fw-medium"></label>
                    <div class="input-group" style="max-width: 250px;">
                        <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="480" />
                        <span class="input-group-text">minutes</span>
                    </div>
                    <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-medium">Activate exam immediately</label>
                    </div>
                    <div class="form-text">Only one active exam can be taken by students at a time.</div>
                </div>

                <hr class="my-4" />
                <p class="fw-semibold mb-3 text-ncs"><i class="bi bi-calendar-event me-2"></i>Exam Schedule (optional)</p>
                <div class="form-text mb-3">If set, students can only log in during this window. The timer is also capped at the end time, so a student who starts late gets only the remaining window time.</div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="ScheduledStart" class="form-label fw-medium"></label>
                        <input asp-for="ScheduledStart" class="form-control" type="datetime-local" />
                        <span asp-validation-for="ScheduledStart" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ScheduledEnd" class="form-label fw-medium"></label>
                        <input asp-for="ScheduledEnd" class="form-control" type="datetime-local" />
                        <span asp-validation-for="ScheduledEnd" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-ncs-primary px-4">
                        <i class="bi bi-check-circle me-2"></i>Create &amp; Add Questions
                    </button>
                    <a asp-controller="Admin" asp-action="Exams" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
