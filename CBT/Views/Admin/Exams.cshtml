@model List<NCS.CBT.Models.Exam>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Exams";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="page-header mb-0">
            <h2 class="page-title"><i class="bi bi-journal-text me-2"></i>Exams</h2>
            <p class="text-muted mb-0">Manage examination papers and questions</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateExam" class="btn btn-ncs-primary">
            <i class="bi bi-plus-circle me-2"></i>New Exam
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card ncs-card text-center py-5">
            <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">No exams yet</h5>
            <p class="text-muted">Create your first exam to get started.</p>
            <a asp-controller="Admin" asp-action="CreateExam" class="btn btn-ncs-primary mx-auto" style="width:fit-content">
                <i class="bi bi-plus-circle me-2"></i>Create Exam
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var exam in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card ncs-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title mb-0 fw-semibold">@exam.Title</h5>
                                <span class="badge @(exam.IsActive ? "bg-success" : "bg-secondary")">
                                    @(exam.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(exam.Description))
                            {
                                <p class="card-text text-muted small">@exam.Description</p>
                            }
                            <div class="d-flex gap-3 mb-3 text-muted small">
                                <span><i class="bi bi-clock me-1"></i>@exam.DurationMinutes mins</span>
                                <span><i class="bi bi-question-circle me-1"></i>@exam.Questions.Count questions</span>
                                <span><i class="bi bi-people me-1"></i>@exam.ExamSessions.Count(s => s.IsSubmitted) done</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pt-0">
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="Admin" asp-action="Questions" asp-route-examId="@exam.Id" class="btn btn-sm btn-ncs-outline">
                                    <i class="bi bi-list-ul me-1"></i>Questions
                                </a>
                                <a asp-controller="Admin" asp-action="EditExam" asp-route-id="@exam.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <form asp-controller="Admin" asp-action="ToggleExamStatus" asp-route-id="@exam.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(exam.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        <i class="bi @(exam.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                        @(exam.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                                <form asp-controller="Admin" asp-action="DeleteExam" asp-route-id="@exam.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this exam and all its questions? This cannot be undone.')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
