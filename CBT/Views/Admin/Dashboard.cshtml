@model AdminDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <div class="page-header mb-4">
        <h2 class="page-title"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
        <p class="text-muted mb-0">Welcome back, @User.Identity?.Name</p>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-green">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@Model.TotalStudents</div>
                    <div class="stat-label">Total Students</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-blue">
                <div class="stat-icon"><i class="bi bi-journal-text"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@Model.TotalExams</div>
                    <div class="stat-label">Total Exams</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-orange">
                <div class="stat-icon"><i class="bi bi-activity"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@Model.ActiveSessions</div>
                    <div class="stat-label">Active Sessions</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card stat-purple">
                <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@Model.CompletedExams</div>
                    <div class="stat-label">Completed</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-4 mb-4">
        <div class="col-md-12">
            <div class="card ncs-card">
                <div class="card-header ncs-card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="Admin" asp-action="CreateExam" class="btn btn-ncs-primary">
                            <i class="bi bi-plus-circle me-2"></i>New Exam
                        </a>
                        <a asp-controller="Admin" asp-action="CreateStudent" class="btn btn-ncs-outline">
                            <i class="bi bi-person-plus me-2"></i>Add Student
                        </a>
                        <a asp-controller="Admin" asp-action="Results" class="btn btn-outline-secondary">
                            <i class="bi bi-bar-chart me-2"></i>View Results
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Results -->
    <div class="card ncs-card">
        <div class="card-header ncs-card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Submissions</h5>
            <a asp-controller="Admin" asp-action="Results" class="btn btn-sm btn-ncs-outline">View All</a>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentSessions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Student No.</th>
                                <th>Exam</th>
                                <th>Score</th>
                                <th>Percentage</th>
                                <th>Submitted</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RecentSessions)
                            {
                                var pct = r.Total > 0 ? (double)r.Score / r.Total * 100 : 0;
                                <tr>
                                    <td class="fw-medium">@r.StudentName</td>
                                    <td><span class="badge bg-secondary">@r.StudentNumber</span></td>
                                    <td class="text-muted small">@r.ExamTitle</td>
                                    <td><strong>@r.Score</strong>/@r.Total</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;">
                                                <div class="progress-bar @(pct >= 50 ? "bg-success" : "bg-danger")"
                                                     style="width:@pct%"></div>
                                            </div>
                                            <small class="text-nowrap @(pct >= 50 ? "text-success" : "text-danger") fw-bold">@pct.ToString("F0")%</small>
                                        </div>
                                    </td>
                                    <td class="text-muted small">@r.SubmittedAt.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No submissions yet
                </div>
            }
        </div>
    </div>
</div>
