@model List<BulkUploadResultItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Bulk Upload Results";
    var succeeded = Model.Count(r => r.Success);
    var failed = Model.Count(r => !r.Success);
    var emailed = Model.Count(r => r.Success && r.EmailSent);
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="Admin" asp-action="Students" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="page-title mb-0"><i class="bi bi-list-check me-2"></i>Bulk Upload Results</h2>
            <p class="text-muted mb-0">@succeeded registered &bull; @emailed emailed &bull; @failed failed</p>
        </div>
    </div>

    @if (succeeded > 0)
    {
        <div class="alert alert-success border-0">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>@succeeded student(s) registered.</strong>
            @if (emailed > 0) { <span>Credentials emailed to @emailed student(s).</span> }
        </div>
    }
    @if (failed > 0)
    {
        <div class="alert alert-warning border-0">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>@failed row(s) could not be processed.</strong> See details below.
        </div>
    }

    <div class="card ncs-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Row</th>
                            <th>Student Number</th>
                            <th>Full Name</th>
                            <th>Access PIN</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr class="@(r.Success ? "" : "table-danger")">
                                <td class="text-muted small">@r.Row</td>
                                <td><span class="badge bg-secondary">@r.StudentNumber</span></td>
                                <td>@r.FullName</td>
                                <td>
                                    @if (r.Success)
                                    {
                                        <code class="fs-6 fw-bold text-primary">@r.AccessCode</code>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.Success)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>OK</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="@r.Error"><i class="bi bi-x-circle me-1"></i>Failed</span>
                                        <div class="small text-danger">@r.Error</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.Success)
                                    {
                                        @if (r.EmailSent)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-envelope-check me-1"></i>Sent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-envelope-slash me-1"></i>Skipped</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Students" class="btn btn-ncs-primary">
            <i class="bi bi-people me-2"></i>View All Students
        </a>
        <a asp-controller="Admin" asp-action="BulkUpload" class="btn btn-outline-secondary ms-2">
            <i class="bi bi-upload me-2"></i>Upload Another File
        </a>
    </div>
</div>
