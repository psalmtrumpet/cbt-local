@model BulkPassportUploadViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Upload Passport Photos";
}

<div class="container py-4" style="max-width: 640px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="Admin" asp-action="Students" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="page-title mb-0"><i class="bi bi-person-badge me-2"></i>Bulk Upload Passport Photos</h2>
            <p class="text-muted mb-0">Upload a ZIP file containing passport photos for multiple students</p>
        </div>
    </div>

    <div class="card ncs-card mb-4">
        <div class="card-body p-4">
            <h6 class="fw-semibold mb-3"><i class="bi bi-archive me-2 text-ncs"></i>ZIP File Format</h6>
            <p class="text-muted small mb-2">Create a ZIP file where each photo is named <strong>exactly</strong> as the student's Student Number:</p>
            <div class="bg-light rounded p-3 mb-3 small font-monospace">
                passports.zip<br>
                &nbsp;&nbsp;├── NCS2026001.jpg<br>
                &nbsp;&nbsp;├── NCS2026002.jpg<br>
                &nbsp;&nbsp;├── NCS2026003.png<br>
                &nbsp;&nbsp;└── ...
            </div>
            <ul class="text-muted small mb-0">
                <li>Accepted formats: <strong>.jpg, .jpeg, .png</strong></li>
                <li>File name must match the Student Number exactly (case-sensitive)</li>
                <li>Photos not matching any registered student are skipped</li>
                <li>Uploading again for the same student overwrites the previous photo</li>
            </ul>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="card ncs-card">
        <div class="card-body p-4">
            <form asp-controller="Admin" asp-action="UploadPassports" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="ZipFile" class="form-label fw-medium"></label>
                    <input asp-for="ZipFile" class="form-control" type="file" accept=".zip" />
                    <span asp-validation-for="ZipFile" class="text-danger small"></span>
                    <div class="form-text">Maximum file size: 50 MB</div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-ncs-primary px-4">
                        <i class="bi bi-cloud-upload me-2"></i>Upload Passports
                    </button>
                    <a asp-controller="Admin" asp-action="Students" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
