@model List<ProctorListViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Proctors";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="page-header mb-0">
            <h2 class="page-title"><i class="bi bi-eye me-2"></i>Proctors</h2>
            <p class="text-muted mb-0">Manage proctor / viewer accounts</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateProctor" class="btn btn-ncs-primary">
            <i class="bi bi-person-plus me-2"></i>Add Proctor
        </a>
    </div>

    <div class="card ncs-card">
        <div class="card-header ncs-card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-people me-2"></i>Registered Proctors</h5>
            <span class="badge bg-secondary">@Model.Count total</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Registered</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="fw-medium">
                                        <i class="bi bi-person-badge text-ncs me-2"></i>@p.FullName
                                    </td>
                                    <td class="text-muted">@p.Email</td>
                                    <td class="text-muted small">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <a asp-controller="Admin" asp-action="ResetProctorPassword"
                                           asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-secondary me-1">
                                            <i class="bi bi-key me-1"></i>Reset Password
                                        </a>
                                        <form asp-controller="Admin" asp-action="DeleteProctor" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Remove proctor @Html.Raw(p.FullName.Replace("'", "\\'"))? They will no longer be able to log in.');">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash me-1"></i>Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                    No proctors registered yet.
                    <div class="mt-3">
                        <a asp-controller="Admin" asp-action="CreateProctor" class="btn btn-ncs-primary">
                            <i class="bi bi-person-plus me-2"></i>Add First Proctor
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="alert alert-info border-0 mt-4 small">
        <i class="bi bi-info-circle me-2"></i>
        Proctors log in at the <strong>Staff Login</strong> page using their email and password.
        They can view the <strong>Live Monitor</strong> dashboard and disqualify students if needed.
        They cannot manage exams, students, or results.
    </div>
</div>
