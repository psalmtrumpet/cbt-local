@model ResetProctorPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reset Proctor Password";
}

<div class="container py-4" style="max-width: 480px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="Admin" asp-action="Proctors" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="page-title mb-0"><i class="bi bi-key me-2"></i>Reset Password</h2>
            <p class="text-muted mb-0">@Model.FullName</p>
        </div>
    </div>

    <div class="card ncs-card">
        <div class="card-body p-4">
            <form asp-controller="Admin" asp-action="ResetProctorPassword" method="post">
                <input asp-for="Id" type="hidden" />
                <input asp-for="FullName" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label fw-medium"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" class="form-control" type="password"
                               placeholder="Minimum 6 characters" id="newPass" autofocus />
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="const i=document.getElementById('newPass');i.type=i.type==='password'?'text':'password';">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-ncs-primary px-4">
                        <i class="bi bi-check-circle me-2"></i>Set New Password
                    </button>
                    <a asp-controller="Admin" asp-action="Proctors" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
