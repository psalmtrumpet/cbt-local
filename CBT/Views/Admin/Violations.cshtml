@model NCS.CBT.ViewModels.ViolationsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Proctoring Violations";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="page-header mb-0">
            <h2 class="page-title"><i class="bi bi-shield-exclamation me-2"></i>Proctoring Violations</h2>
            <p class="text-muted mb-0">All detected violations across exam sessions</p>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="stat-card stat-red">
                <div class="stat-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@Model.TotalViolations</div>
                    <div class="stat-label">Total Violations</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="stat-card stat-orange">
                <div class="stat-icon"><i class="bi bi-person-slash"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@Model.DisqualifiedCount</div>
                    <div class="stat-label">Disqualified</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Violations Table -->
    <div class="card ncs-card">
        <div class="card-header ncs-card-header">
            <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Violation Log</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Violations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Snapshot</th>
                                <th>Student</th>
                                <th>Exam</th>
                                <th>Offence</th>
                                <th>Time</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Violations)
                            {
                                string vIcon = "bi-exclamation-circle";
                                string vColor = "secondary";
                                string vLabel = v.ViolationType;
                                if (v.ViolationType == "NO_FACE") { vIcon = "bi-camera-video-off"; vColor = "danger"; vLabel = "No Face Detected"; }
                                else if (v.ViolationType == "MULTIPLE_FACES") { vIcon = "bi-people-fill"; vColor = "danger"; vLabel = "Multiple Faces"; }
                                else if (v.ViolationType == "LOOKING_AWAY") { vIcon = "bi-eye-slash"; vColor = "warning"; vLabel = "Looking Away"; }
                                else if (v.ViolationType == "LIP_MOVEMENT") { vIcon = "bi-chat-dots"; vColor = "warning"; vLabel = "Lip Movement"; }
                                else if (v.ViolationType == "TAB_SWITCH") { vIcon = "bi-window-dash"; vColor = "warning"; vLabel = "Tab Switch"; }
                                <tr class="@(v.IsDisqualified ? "table-danger" : "")">
                                    <td style="width:110px;">
                                        @if (!string.IsNullOrEmpty(v.SnapshotPath))
                                        {
                                            <a href="@Url.Action("Snapshot", "Proctor", new { path = v.SnapshotPath })" target="_blank" title="Click to view full image">
                                                <img src="@Url.Action("Snapshot", "Proctor", new { path = v.SnapshotPath })"
                                                     style="width:100px;height:75px;object-fit:cover;border-radius:6px;border:2px solid #dee2e6;"
                                                     onerror="this.parentElement.innerHTML='<span class=\'text-muted small\'>No image</span>'" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div style="width:100px;height:75px;background:#f8f9fa;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-camera-video-off text-muted fs-4"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-medium">@v.StudentName</div>
                                        <span class="badge bg-secondary">@v.StudentNumber</span>
                                    </td>
                                    <td class="text-muted small">@v.ExamTitle</td>
                                    <td>
                                        <span class="badge bg-@vColor">
                                            <i class="bi @vIcon me-1"></i>@vLabel
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>@v.Timestamp.ToLocalTime().ToString("dd MMM HH:mm:ss")
                                    </td>
                                    <td class="text-center">
                                        @if (v.IsDisqualified)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-person-slash me-1"></i>Disqualified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Flagged</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-shield-check fs-1 d-block mb-2 text-success"></i>
                    <p>No violations recorded yet.</p>
                </div>
            }
        </div>
    </div>
</div>
