@model ViewerDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Live Monitor";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="page-header mb-0">
            <h2 class="page-title"><i class="bi bi-activity me-2"></i>Live Exam Monitor</h2>
            <p class="text-muted mb-0">Real-time examination progress</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-success fs-6" id="connectionBadge">
                <i class="bi bi-broadcast me-1"></i>Connecting...
            </span>
            <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-3">
            <div class="stat-card stat-orange">
                <div class="stat-icon"><i class="bi bi-activity"></i></div>
                <div class="stat-info">
                    <div class="stat-value" id="activeCount">@Model.TotalActive</div>
                    <div class="stat-label">Active Now</div>
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="stat-card stat-green">
                <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value" id="completedCount">@Model.TotalCompleted</div>
                    <div class="stat-label">Completed</div>
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="stat-card stat-blue">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@(Model.TotalActive + Model.TotalCompleted)</div>
                    <div class="stat-label">Total Students</div>
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="stat-card stat-red">
                <div class="stat-icon"><i class="bi bi-shield-exclamation"></i></div>
                <div class="stat-info">
                    <div class="stat-value" id="violationCountBadge">0</div>
                    <div class="stat-label">Violations (live)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Violations Feed -->
    <div class="card ncs-card mb-4 border-danger">
        <div class="card-header d-flex justify-content-between align-items-center" style="background:#dc354515;">
            <h5 class="mb-0 text-danger"><i class="bi bi-shield-exclamation me-2"></i>Live Violation Alerts</h5>
            <span class="badge bg-danger" id="violationFeedBadge">Real-time</span>
        </div>
        <div class="card-body p-3" style="max-height:420px;overflow-y:auto;">
            <div id="violationFeed">
                <p class="text-muted text-center small mb-0">No violations detected yet in this session.</p>
            </div>
        </div>
    </div>

    <!-- Active Sessions -->
    <div class="card ncs-card mb-4">
        <div class="card-header ncs-card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-broadcast me-2"></i>Active Sessions</h5>
            <span class="badge bg-warning text-dark" id="activeBadge">@Model.TotalActive active</span>
        </div>
        <div class="card-body p-0">
            <div id="activeSessionsContainer">
                @if (Model.ActiveStudents.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="activeTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Student</th>
                                    <th>Student No.</th>
                                    <th>Exam</th>
                                    <th style="min-width:200px;">Progress</th>
                                    <th class="text-center">Score</th>
                                    <th class="text-center">Time Left</th>
                                </tr>
                            </thead>
                            <tbody id="activeTableBody">
                                @foreach (var s in Model.ActiveStudents)
                                {
                                    var progressPct = s.TotalQuestions > 0 ? (double)s.QuestionsAnswered / s.TotalQuestions * 100 : 0;
                                    <tr id="row-@s.SessionId">
                                        <td class="fw-medium">@s.StudentName</td>
                                        <td><span class="badge bg-secondary">@s.StudentNumber</span></td>
                                        <td class="text-muted small">@s.ExamTitle</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height:10px;">
                                                    <div class="progress-bar bg-ncs progress-bar-striped progress-bar-animated"
                                                         id="prog-@s.SessionId"
                                                         style="width:@progressPct%"></div>
                                                </div>
                                                <small class="text-nowrap text-ncs fw-bold" id="progText-@s.SessionId">
                                                    @s.QuestionsAnswered/@s.TotalQuestions
                                                </small>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-ncs-light text-ncs fw-bold fs-6" id="score-@s.SessionId">
                                                @s.CurrentScore/@s.TotalQuestions
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="timer-badge" id="time-@s.SessionId"
                                                  data-remaining="@s.RemainingSeconds">
                                                <i class="bi bi-clock me-1"></i>--:--
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted" id="noActiveMsg">
                        <i class="bi bi-hourglass fs-1 d-block mb-2"></i>
                        No students are currently taking an exam
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Completed Sessions -->
    <div class="card ncs-card">
        <div class="card-header ncs-card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-check-all me-2"></i>Completed</h5>
            <span class="badge bg-success" id="completedBadge">@Model.TotalCompleted completed</span>
        </div>
        <div class="card-body p-0">
            @if (Model.CompletedStudents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Student No.</th>
                                <th>Exam</th>
                                <th class="text-center">Score</th>
                                <th style="min-width:140px;">Performance</th>
                                <th>Submitted</th>
                                <th class="text-center">Violations</th>
                            </tr>
                        </thead>
                        <tbody id="completedTableBody">
                            @foreach (var s in Model.CompletedStudents)
                            {
                                <tr class="@(s.IsDisqualified ? "table-danger" : "")">
                                    <td class="fw-medium">
                                        @s.StudentName
                                        @if (s.IsDisqualified)
                                        {
                                            <span class="badge bg-danger ms-1">DISQUALIFIED</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary">@s.StudentNumber</span></td>
                                    <td class="text-muted small">@s.ExamTitle</td>
                                    <td class="text-center">
                                        <strong class="@(s.Percentage >= 50 ? "text-success" : "text-danger")">
                                            @s.Score/@s.TotalQuestions
                                        </strong>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:10px;">
                                                <div class="progress-bar @(s.Percentage >= 70 ? "bg-success" : s.Percentage >= 50 ? "bg-warning" : "bg-danger")"
                                                     style="width:@s.Percentage%"></div>
                                            </div>
                                            <small class="fw-bold text-nowrap @(s.Percentage >= 50 ? "text-success" : "text-danger")">
                                                @s.Percentage%
                                            </small>
                                        </div>
                                    </td>
                                    <td class="text-muted small">
                                        @s.EndTime?.ToLocalTime().ToString("HH:mm:ss")
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm @(s.ViolationCount > 0 ? "btn-danger" : "btn-outline-secondary")"
                                                onclick="showViolationsModal(@s.SessionId)">
                                            @if (s.ViolationCount > 0)
                                            {
                                                <i class="bi bi-shield-exclamation me-1"></i>
                                                @s.ViolationCount
                                            }
                                            else
                                            {
                                                <i class="bi bi-shield-check me-1"></i>
                                                <text>None</text>
                                            }
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted" id="noCompletedMsg">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    No completed exams yet
                </div>
            }
        </div>
    </div>
</div>

<!-- Violations Review Modal -->
<div class="modal fade" id="violationsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0" style="background:linear-gradient(135deg,#dc3545,#c82333);color:#fff;">
                <h5 class="modal-title fw-bold" id="violationsModalTitle">
                    <i class="bi bi-shield-exclamation me-2"></i>Proctoring Violations
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Student summary bar -->
                <div id="violationsModalSummary" class="px-4 py-3 border-bottom bg-light"></div>
                <!-- Violation list -->
                <div id="violationsModalBody" class="p-3"></div>
            </div>
            <div class="modal-footer border-0 justify-content-between">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger fw-bold" id="violationsDisqualifyBtn" style="display:none;"
                        onclick="disqualifyFromModal()">
                    <i class="bi bi-slash-circle me-2"></i>Disqualify Student
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script src="~/js/viewer.js" asp-append-version="true"></script>
}
