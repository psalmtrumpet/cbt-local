@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Admin / Viewer Login";
}

<div class="login-wrapper">
    <div class="login-card shadow-lg">
        <div class="login-header">
            <div class="login-logo">
                <i class="bi bi-pc-display-horizontal"></i>
            </div>
            <h1 class="login-title">TLIMC CBT</h1>
            <p class="login-subtitle">TLIMC &mdash; Computer-Based Test</p>
        </div>

        <div class="login-body-section">
            <h5 class="text-center mb-4 fw-semibold text-dark">Staff Login</h5>

            @if (Context.Request.Query["expired"] == "1")
            {
                <div class="alert alert-warning border-0">
                    <i class="bi bi-arrow-clockwise me-2"></i>Your session expired. Please log in again.
                </div>
            }
            @if (!string.IsNullOrEmpty(TempData["ErrorMessage"]?.ToString()))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-medium"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" type="email" placeholder="staff@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-medium"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Enter password" id="passwordInput" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-ncs-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </button>
            </form>

        </div>
    </div>

    <div class="login-footer-text text-center mt-4 text-white-50">
        <small>&copy; @DateTime.Now.Year TLIMC</small>
    </div>
    <div class="text-center mt-2">
        <a href="/Account/StudentLogin" class="text-white-50 small">Student Login &rarr;</a>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}
