# Copy this file to .env on the VPS and fill in real values.
# NEVER commit .env to source control.

# Strong password — min 8 chars, uppercase, lowercase, digit, symbol
DB_SA_PASSWORD=Change_Me_Strong_Password_Here!

# Anthropic API key for AI theory question grading (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Hostinger SMTP password for info@tlimc.net (used to email exam credentials to students)
SMTP_PASSWORD=Change_Me_SMTP_Password_Here

# Azure Face API — get from Azure Portal > Cognitive Services > Face
# Endpoint e.g. https://eastus.api.cognitive.microsoft.com
# Leave blank to skip face matching (students pass through automatically)
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=
