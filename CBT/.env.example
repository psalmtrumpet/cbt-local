# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Database ───────────────────────────────────────────────────────────────────
# Strong password — min 8 chars, uppercase, lowercase, digit, symbol
DB_SA_PASSWORD=LocalCbt@2024!

# ── This machine's LAN IP ──────────────────────────────────────────────────────
# Run: ipconfig  — use the IPv4 Address (e.g. 192.168.1.50)
# This is used in credential emails so students get the right link.
LOCAL_IP=192.168.1.50

# ── AI Grading (Anthropic) ─────────────────────────────────────────────────────
# Get from console.anthropic.com — required for theory question grading
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=info@tlimc.net
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM_NAME=CBT System

# ── Azure Face Verification (optional) ────────────────────────────────────────
# Leave blank to skip face matching (students pass through automatically)
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=
